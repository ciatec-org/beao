# ==============================================================================
# BEAO-BR — Built Environment Accessibility Ontology — Brazil Module
# Version: 0.1.0
# URI base: https://w3id.org/beao/br#
# Imports: https://w3id.org/beao (BEAO core v0.1.0)
# Normative source: ABNT NBR 9050:2020 (corrected version 25.01.2021)
# License: CC BY 4.0
#
# This module extends the BEAO core ontology with:
#   - Concrete PhysicalElement subclasses derived from NBR 9050:2020
#   - Concrete SpaceType subclasses (§10 typologies)
#   - AccessibilityRequirement instances (§3–§10, 212 claims)
#   - Condition instances
#   - SHACL shapes with NBR 9050:2020 specific values
#   - ReferenceModule instance (M.R. 0.80m × 1.20m)
#   - Provenance linked to ABNT NBR 9050:2020
#
# NOTE ON SPACETYPES:
#   Concrete SpaceTypes (EventSpace, School, Pool, etc.) are declared here
#   as subclasses of beao:SpaceType, derived from §10 of NBR 9050:2020.
#   These are Brazilian normative typologies. Concepts coincident with other
#   national modules may be aligned via owl:equivalentClass without creating
#   inter-module dependencies.
#
# ==============================================================================

@prefix beao-br: <https://w3id.org/beao/br#> .
@prefix beao:    <https://w3id.org/beao#> .
@prefix bot:     <https://w3id.org/bot#> .
@prefix earl:    <http://www.w3.org/ns/earl#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ==============================================================================
# ONTOLOGY METADATA
# ==============================================================================

<https://w3id.org/beao/br>
    a owl:Ontology ;
    rdfs:label "BEAO-BR — Built Environment Accessibility Ontology — Brazil Module"@en ;
    owl:versionInfo "0.1.0" ;
    dcterms:description "Brazilian national module of the BEAO core ontology. Formalizes accessibility requirements from ABNT NBR 9050:2020 as machine-interpretable OWL 2 DL axioms and SHACL shapes. Contains 212 normative claims (§3–§10)."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Eduardo Dati Dias" ;
    dcterms:creator "Jean Orlando" ;
    dcterms:creator "Carlos Bandeira de Mello Monteiro" ;
    beao:normVersion "NBR9050:2020" ;
    prov:wasDerivedFrom <https://www.abnt.org.br/normalizacao/lista-de-publicacoes/abnt?ID=1311> ;
    owl:imports <https://w3id.org/beao> .

# ==============================================================================
# SECTION 1 — REFERENCE MODULE (NBR 9050:2020 §4.2.2)
# ==============================================================================

beao-br:ReferenceModule_NBR9050
    a beao:ReferenceModule ;
    rdfs:label "Reference Module — NBR 9050:2020"@en ;
    beao:width 0.80 ;
    beao:length 1.20 ;
    skos:note "Floor projection of a wheelchair user: 0.80m × 1.20m — §4.2.2 NBR 9050:2020"@en ;
    beao:normativeReference "4.2.2 NBR 9050:2020" .

# ==============================================================================
# SECTION 2 — CONDITIONS (NBR 9050:2020 specific)
# ==============================================================================

beao-br:NoLateralWalls a beao:Condition ;
    rdfs:label "No lateral walls"@en ;
    beao:normativeReference "6.6.2.8 NBR 9050:2020" .

beao-br:HasRevolvingDoor a beao:Condition ;
    rdfs:label "Has revolving door"@en ;
    beao:normativeReference "6.2.7 NBR 9050:2020" .

beao-br:HasSecurityDevice a beao:Condition ;
    rdfs:label "Has security device"@en ;
    beao:normativeReference "6.2.5 NBR 9050:2020" .

beao-br:HasMultipleFloors a beao:Condition ;
    rdfs:label "Has multiple floors"@en ;
    beao:normativeReference "6.10.2 NBR 9050:2020" .

beao-br:IsExistingBuilding a beao:Condition ;
    rdfs:label "Is existing building"@en ;
    beao:normativeReference "6.2.2 NBR 9050:2020" .

beao-br:HasLateralWall a beao:Condition ;
    rdfs:label "Has lateral wall"@en ;
    beao:normativeReference "7.7.2.2.1 NBR 9050:2020" .

beao-br:HasNoLateralWall a beao:Condition ;
    rdfs:label "Has no lateral wall"@en ;
    beao:normativeReference "7.7.2.4 NBR 9050:2020" .

beao-br:NoisyEnvironment a beao:Condition ;
    rdfs:label "Noisy environment"@en ;
    beao:normativeReference "9.2.1.7 NBR 9050:2020" .

beao-br:HasSecurityPartition a beao:Condition ;
    rdfs:label "Has security partition"@en ;
    beao:normativeReference "9.2.1.7 NBR 9050:2020" .

beao-br:TotalPositionsAboveSix a beao:Condition ;
    rdfs:label "Total service positions above six"@en ;
    beao:normativeReference "9.2.1.6 NBR 9050:2020" .

beao-br:PerimeterUpTo90m a beao:Condition ;
    rdfs:label "Pool perimeter up to 90m"@en ;
    beao:normativeReference "10.12.2 NBR 9050:2020" .

beao-br:PerimeterAbove90m a beao:Condition ;
    rdfs:label "Pool perimeter above 90m"@en ;
    beao:normativeReference "10.12.2 NBR 9050:2020" .

beao-br:HasInfrastructure a beao:Condition ;
    rdfs:label "Has infrastructure"@en ;
    beao:normativeReference "10.13.1 NBR 9050:2020" .

beao-br:PhysicalAdaptationImpractical a beao:Condition ;
    rdfs:label "Physical adaptation impractical"@en ;
    beao:normativeReference "10.2.2 NBR 9050:2020" .

beao-br:HeightUpTo60cm a beao:Condition ;
    rdfs:label "Stage height up to 60cm"@en ;
    beao:normativeReference "10.4.3 NBR 9050:2020" .

beao-br:HeightAbove60cm a beao:Condition ;
    rdfs:label "Stage height above 60cm"@en ;
    beao:normativeReference "10.4.3 NBR 9050:2020" .

# ==============================================================================
