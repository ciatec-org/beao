# ==============================================================================
# SECTION 4 — PHYSICAL ELEMENTS (NBR 9050:2020)
# Concrete subclasses of beao:PhysicalElement
# ==============================================================================

# --- Floors ---

beao-br:Floor a owl:Class ;
    rdfs:subClassOf beao:PhysicalElement ;
    rdfs:label "Floor"@en ;
    beao:normativeReference "6.3 NBR 9050:2020" .

beao-br:TactileFloor a owl:Class ;
    rdfs:subClassOf beao-br:Floor ;
    rdfs:label "Tactile Floor"@en ;
    beao:normativeReference "3.1.29 NBR 9050:2020" .

beao-br:AlertTactileFloor a owl:Class ;
    rdfs:subClassOf beao-br:TactileFloor ;
    rdfs:label "Alert Tactile Floor"@en .

beao-br:DirectionalTactileFloor a owl:Class ;
    rdfs:subClassOf beao-br:TactileFloor ;
    rdfs:label "Directional Tactile Floor"@en .

beao-br:DrainGrate a owl:Class ;
    rdfs:subClassOf beao:PhysicalElement ;
    rdfs:label "Drain Grate"@en ;
    beao:normativeReference "6.3.5 NBR 9050:2020" .

beao-br:TreeGrate a owl:Class ;
    rdfs:subClassOf beao-br:DrainGrate ;
    rdfs:label "Tree Grate"@en ;
    beao:normativeReference "8.8.4 NBR 9050:2020" .

