# ==============================================================================
# SECTION 5 — ACCESSIBILITY REQUIREMENTS (NBR 9050:2020 §3–§10)
# 212 normative claims
# ==============================================================================

# --- §4–§6 Core Requirements ---

beao-br:Req_4_2_2_referenceModule a beao:MandatoryRequirement ;
    beao:normativeReference "4.2.2 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    rdfs:label "Reference module dimensions 0.80m x 1.20m"@en .

beao-br:Req_5_1_3_dualSensory a beao:MandatoryRequirement ;
    beao:normativeReference "5.1.3 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:SignageElement ;
    beao:addressesCapability beao:DualSensorySignage ;
    rdfs:label "Dual sensory information principle"@en .

beao-br:Req_5_6_bimodalAlarm a beao:MandatoryRequirement ;
    beao:normativeReference "5.6 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:EmergencyAlarm ;
    beao:addressesCapability beao:VisualPerception ;
    beao:addressesCapability beao:AuditoryPerception ;
    rdfs:label "Bimodal emergency alarm (visual and auditory)"@en .

beao-br:Req_6_1_2_illuminance a beao:MandatoryRequirement ;
    beao:normativeReference "6.1.2 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao:AccessibleRoute ;
    beao:addressesCapability beao:VisualPerception ;
    rdfs:label "Minimum illuminance 150 lux on accessible route"@en .

beao-br:Req_6_2_1_accessibleEntrance a beao:MandatoryRequirement ;
    beao:normativeReference "6.2.1 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:BuildingEntrance ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    beao:addressesCapability beao:ReducedMobilityNavigation ;
    rdfs:label "Accessible building entrance"@en .

beao-br:Req_6_2_7_revolvingDoor a beao:MandatoryRequirement ;
    beao:normativeReference "6.2.7 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:RevolvingDoor ;
    beao:condition beao-br:HasRevolvingDoor ;
    beao:requires beao-br:BuildingEntrance ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    rdfs:label "Alternative accessible entrance required when revolving door exists"@en .

beao-br:Req_6_3_4_1_levelChange a beao:MandatoryRequirement ;
    beao:normativeReference "6.3.4.1 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Floor ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    rdfs:label "Floor level change treatment required"@en .

beao-br:Req_6_6_2_maxSlope_new a beao:MandatoryRequirement ;
    beao:normativeReference "6.6.2 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Ramp ;
    beao:appliesIn beao:NewConstruction ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    beao:addressesCapability beao:ReducedMobilityNavigation ;
    rdfs:label "Maximum ramp slope 8.33% — new construction"@en .

beao-br:Req_6_6_2_maxSlope_reform a beao:MandatoryRequirement ;
    beao:normativeReference "6.6.2 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Ramp ;
    beao:appliesIn beao:Renovation ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    rdfs:label "Maximum ramp slope 12.5% — renovation"@en .

beao-br:Req_6_6_2_8_edgeGuide a beao:MandatoryRequirement ;
    beao:normativeReference "6.6.2.8 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Ramp ;
    beao:condition beao-br:NoLateralWalls ;
    beao:requires beao-br:EdgeGuide ;
    beao:addressesCapability beao:IndependentVisualNavigation ;
    rdfs:label "Edge guide required when ramp has no lateral walls"@en .

beao-br:Req_6_11_2_4_doorClearWidth a beao:MandatoryRequirement ;
    beao:normativeReference "6.11.2.4 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Door ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    beao:addressesCapability beao:ReducedMobilityNavigation ;
    rdfs:label "Door minimum clear width 0.80m"@en .

beao-br:Req_6_11_2_5_openingForce a beao:MandatoryRequirement ;
    beao:normativeReference "6.11.2.5 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Door ;
    beao:addressesCapability beao:ReducedGraspStrength ;
    beao:addressesCapability beao:ReducedMobilityNavigation ;
    rdfs:label "Door maximum opening force 36N"@en .

beao-br:Req_6_11_2_6_leverHandle a beao:MandatoryRequirement ;
    beao:normativeReference "6.11.2.6 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:Door ;
    beao:requires beao-br:LeverHandle ;
    beao:addressesCapability beao:ReducedGraspStrength ;
    rdfs:label "Lever handle required on all accessible doors"@en .

beao-br:Req_7_4_1_accessibleToilet a beao:MandatoryRequirement ;
    beao:normativeReference "7.4.1 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:AccessibleToilet ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    beao:addressesCapability beao:WheelchairTransfer ;
    rdfs:label "Accessible toilet mandatory in public buildings"@en .

beao-br:Req_7_5_maneuveringArea a beao:MandatoryRequirement ;
    beao:normativeReference "7.5 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    beao:appliesTo beao-br:AccessibleToilet ;
    beao:addressesCapability beao:IndependentWheelchairNavigation ;
    rdfs:label "360-degree maneuvering area in accessible toilet"@en .

beao-br:Req_7_9_familyBathroom a beao:RecommendedRequirement ;
    beao:normativeReference "7.9 NBR 9050:2020" ; beao:normVersion "NBR9050:2020" ;
    rdfs:label "Family bathroom recommended"@en .

