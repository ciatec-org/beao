beao-br:IsolatedStep a owl:Class ;
    rdfs:subClassOf beao-br:Step ;
    rdfs:label "Isolated Step"@en .

beao-br:Sidewalk a owl:Class ;
    rdfs:subClassOf beao:PhysicalElement ;
    rdfs:label "Sidewalk"@en ;
    beao:normativeReference "6.12 NBR 9050:2020" .

beao-br:DisabledParkingSpace a owl:Class ;
