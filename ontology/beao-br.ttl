# ==============================================================================
# SECTION 6 — SHACL SHAPES (NBR 9050:2020 specific values)
# ==============================================================================

beao-br:DoorClearWidthShape a sh:NodeShape ;
    sh:targetClass beao-br:Door ;
    sh:property [
        sh:path beao:clearWidth ;
        sh:minInclusive 0.80 ;
        sh:severity sh:Violation ;
        sh:message "Clear width must be >= 0.80m (§6.11.2.4 NBR 9050:2020)"@en
    ] .

beao-br:SportsDoorClearWidthShape a sh:NodeShape ;
    sh:targetClass beao-br:SportsFacilityDoor ;
    sh:property [
        sh:path beao:clearWidth ;
        sh:minInclusive 1.00 ;
        sh:severity sh:Violation ;
        sh:message "Clear width must be >= 1.00m in sports facilities (§6.11.2.4 NBR 9050:2020)"@en
    ] .

beao-br:DoorOpeningForceShape a sh:NodeShape ;
    sh:targetClass beao-br:Door ;
    sh:property [
        sh:path beao:openingForce ;
        sh:maxInclusive 36 ;
        sh:severity sh:Violation ;
        sh:message "Opening force must be <= 36N (§6.11.2.5 NBR 9050:2020)"@en
    ] .

beao-br:AccessibleHorizontalSurfaceShape a sh:NodeShape ;
    sh:targetClass beao-br:AccessibleHorizontalSurface ;
    sh:property [
        sh:path beao:clearanceHeight ;
        sh:minInclusive 0.73 ;
        sh:severity sh:Violation ;
        sh:message "Lower clearance height must be >= 0.73m (§4.6.3 NBR 9050:2020)"@en
    ] .

beao-br:RampSlopeNewShape a sh:NodeShape ;
    sh:targetClass beao-br:Ramp ;
    sh:property [
        sh:path beao:maxSlope ;
        sh:maxInclusive 8.33 ;
        sh:severity sh:Violation ;
        sh:message "Maximum ramp slope is 8.33% for new construction (§6.6.2 NBR 9050:2020)"@en
    ] .

beao-br:AccessibleRouteIlluminanceShape a sh:NodeShape ;
    sh:targetClass beao:AccessibleRoute ;
    sh:property [
        sh:path beao:minimumIlluminance ;
        sh:minInclusive 150 ;
        sh:severity sh:Violation ;
        sh:message "Minimum illuminance on accessible route is 150 lux (§6.1.2 NBR 9050:2020)"@en
    ] .

beao-br:FloorGrateShape a sh:NodeShape ;
    sh:targetClass beao-br:DrainGrate ;
    sh:property [
        sh:path beao:width ;
        sh:maxInclusive 0.015 ;
        sh:severity sh:Violation ;
        sh:message "Grate opening must be <= 15mm (§6.3.5 NBR 9050:2020)"@en
    ] .

beao-br:HandrailHeightShape a sh:NodeShape ;
    sh:targetClass beao-br:Handrail ;
    sh:property [
        sh:path beao:installationHeight ;
        sh:minInclusive 0.70 ;
        sh:maxInclusive 0.92 ;
        sh:severity sh:Violation ;
        sh:message "Handrail height must be between 0.70m and 0.92m (§6.9.3.2 NBR 9050:2020)"@en
    ] .

