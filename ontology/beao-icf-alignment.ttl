# ==============================================================================
# BEAO–ICF Alignment
# Version: 0.1.1
# URI base: https://w3id.org/beao/icf-alignment
# Depends on: beao.ttl v0.1.0
# Normative sources: ABNT NBR 9050:2020 + WHO ICF 2026-01
# License: CC BY 4.0
#
# Semantic alignment between BEAO FunctionalCapabilities and WHO ICF codes.
# Operationalizes ICF environmental factor qualification through measurable
# normative requirements derived from national modules (beao-br: NBR 9050:2020).
#
# Decision CD-08: All FunctionalCapability → ICF mappings live here,
# not in beao core. Rationale: core stability — adding an ICF code
# discovered in a new national module must not force a core version bump.
#
# Changelog v0.1.1:
#   - Removed icf:d455 from ReducedMobilityNavigation
#     Reason: WHO ICF 2026-01 definition — "moving in ways other than walking"
#     (crawling, climbing, swimming) — incompatible with P.M.R. with walker/crutch.
#     d450 (walking) already covers the correct context and remains mapped.
#     Verified against WHO ICF 2026-01, September 2026.
#   - Renamed abao: → beao: throughout
#   - All labels and comments translated to English (primary language)
#   - ICF prefix corrected to http://hl7.org/fhir/sid/icf/
#   - Concrete mappings migrated from core per CD-08
#
# Decisions applied:
#   CI-01 — alignment entry point: FunctionalCapability, not PhysicalElement
#   CI-02 — granularity: block (e.g. e150), not chapter nor leaf code
#   CI-03 — e = primary (removesBarrierTo); d = context (relatedToActivity)
#   CI-06 — properties: beao:removesBarrierTo and beao:relatedToActivity
#   CI-07 — inclusion requires: (1) built environment can improve/worsen the factor +
#            (2) at least one national module normative standard addresses the code
# ==============================================================================

@prefix beao:    <https://w3id.org/beao#> .
@prefix icf:     <http://hl7.org/fhir/sid/icf/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

# ==============================================================================
# ONTOLOGY METADATA
# ==============================================================================

<https://w3id.org/beao/icf-alignment>
    a owl:Ontology ;
    rdfs:label "BEAO–ICF Alignment"@en ;
    owl:versionInfo "0.1.1" ;
    owl:priorVersion "0.1.0" ;
    owl:imports <https://w3id.org/beao> ;
    dcterms:description "Semantic alignment between BEAO FunctionalCapabilities and WHO ICF codes. Operationalizes ICF environmental factor qualification through measurable normative requirements derived from NBR 9050:2020 (beao-br)."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "Eduardo Dati Dias" ;
    dcterms:creator "Jean Orlando" ;
    dcterms:creator "Carlos Bandeira de Mello Monteiro" ;
    dcterms:source "WHO ICF 2026-01" ;
    dcterms:source "ABNT NBR 9050:2020" ;
    rdfs:seeAlso <http://hl7.org/fhir/sid/icf> ;
    rdfs:seeAlso <https://hl7.org/fhir/6.0.0-snapshot1/references.html> ;
    prov:wasDerivedFrom <https://www.who.int/classifications/international-classification-of-functioning-disability-and-health> ;
    prov:wasDerivedFrom <https://www.abnt.org.br/normalizacao/lista-de-publicacoes/abnt?ID=1311> .

# ==============================================================================
# SECTION 1 — ICF FHIR CODING SYSTEM
# ==============================================================================

<http://hl7.org/fhir/sid/icf>
    a owl:NamedIndividual ;
    rdfs:label "ICF — HL7 FHIR CodeSystem"@en .

# ==============================================================================
# SECTION 2 — PROPERTY CHAIN DOCUMENTATION
#
# Chains defined in beao core (beao.ttl Section 9):
#   beao:assessmentImpactsProfile
#   beao:assessmentRemovesBarrierTo
#   beao:assessmentRelatedToActivity
#
# Full inference chain:
#   ConformityAssessment
#     → (beao:appliedRequirement) → AccessibilityRequirement
#     → (beao:addressesCapability) → FunctionalCapability
#     → (beao:removesBarrierTo / beao:relatedToActivity) → icf:eXXX / icf:dXXX
#
# ICF qualification result:
#   ConformityAssessment [earl:passed]  → environment as facilitator (e+)
#   ConformityAssessment [earl:failed]  → environment as barrier (e.)
#
# Theoretical contribution: operationalizes ICF environmental factor
# qualification via measurable normative requirements. Not identified in
# previously published accessibility ontologies.
#
# Note: SWRL rules for conditional inference (passed/failed → ICF qualifier)
# were evaluated and rejected — they exit OWL 2 DL profile.
# Implementation as SPARQL CONSTRUCT is registered as future work.
# ==============================================================================

# ==============================================================================
# SECTION 3 — ICF NAMED INDIVIDUALS
# Only codes actually referenced in the mappings below are declared.
# Unused codes are not pre-declared (per CI-07 — inclusion requires
# a national module normative standard addressing the code).
# ==============================================================================

# --- Environmental factors (e codes) ---
icf:e115 a owl:NamedIndividual ; rdfs:label "e115 — Products for personal use in daily living"@en .
icf:e120 a owl:NamedIndividual ; rdfs:label "e120 — Products for personal indoor and outdoor mobility"@en .
icf:e125 a owl:NamedIndividual ; rdfs:label "e125 — Products for communication"@en .
icf:e140 a owl:NamedIndividual ; rdfs:label "e140 — Products for culture, recreation and sport"@en .
icf:e150 a owl:NamedIndividual ; rdfs:label "e150 — Design, construction and building products and technology for public use"@en .
icf:e155 a owl:NamedIndividual ; rdfs:label "e155 — Design, construction and building products and technology for private use"@en .
icf:e240 a owl:NamedIndividual ; rdfs:label "e240 — Light"@en .
icf:e250 a owl:NamedIndividual ; rdfs:label "e250 — Sound"@en .
icf:e255 a owl:NamedIndividual ; rdfs:label "e255 — Vibration"@en .
icf:e515 a owl:NamedIndividual ; rdfs:label "e515 — Architecture and construction services, systems and policies"@en .
icf:e520 a owl:NamedIndividual ; rdfs:label "e520 — Open space planning services, systems and policies"@en .
icf:e525 a owl:NamedIndividual ; rdfs:label "e525 — Housing services, systems and policies"@en .
icf:e535 a owl:NamedIndividual ; rdfs:label "e535 — Communication services, systems and policies"@en .
icf:e545 a owl:NamedIndividual ; rdfs:label "e545 — Civil protection services, systems and policies"@en .

# --- Activities and participation (d codes) ---
icf:d110 a owl:NamedIndividual ; rdfs:label "d110 — Watching"@en .
icf:d115 a owl:NamedIndividual ; rdfs:label "d115 — Listening"@en .
icf:d120 a owl:NamedIndividual ; rdfs:label "d120 — Other purposeful sensing"@en .
icf:d310 a owl:NamedIndividual ; rdfs:label "d310 — Communicating with — receiving — spoken messages"@en .
icf:d315 a owl:NamedIndividual ; rdfs:label "d315 — Communicating with — receiving — nonverbal messages"@en .
icf:d320 a owl:NamedIndividual ; rdfs:label "d320 — Communicating with — receiving — formal sign language messages"@en .
icf:d410 a owl:NamedIndividual ; rdfs:label "d410 — Changing basic body position"@en .
icf:d415 a owl:NamedIndividual ; rdfs:label "d415 — Maintaining a body position"@en .
icf:d420 a owl:NamedIndividual ; rdfs:label "d420 — Transferring oneself"@en .
icf:d430 a owl:NamedIndividual ; rdfs:label "d430 — Lifting and carrying objects"@en .
icf:d440 a owl:NamedIndividual ; rdfs:label "d440 — Fine hand use"@en .
icf:d445 a owl:NamedIndividual ; rdfs:label "d445 — Hand and arm use"@en .
icf:d450 a owl:NamedIndividual ; rdfs:label "d450 — Walking"@en .
icf:d460 a owl:NamedIndividual ; rdfs:label "d460 — Moving around in different locations"@en .
icf:d465 a owl:NamedIndividual ; rdfs:label "d465 — Moving around using equipment"@en .
icf:d510 a owl:NamedIndividual ; rdfs:label "d510 — Washing oneself"@en .
icf:d520 a owl:NamedIndividual ; rdfs:label "d520 — Caring for body parts"@en .
icf:d530 a owl:NamedIndividual ; rdfs:label "d530 — Toileting"@en .
icf:d620 a owl:NamedIndividual ; rdfs:label "d620 — Acquisition of goods and services"@en .
icf:d910 a owl:NamedIndividual ; rdfs:label "d910 — Community life"@en .

# ==============================================================================
# SECTION 4 — MAPPINGS (12 FunctionalCapabilities → ICF codes)
# ==============================================================================

# ------------------------------------------------------------------------------
# 01 — IndependentWheelchairNavigation
# Normative reference: NBR 9050:2020 §4.2.2, §6
# ------------------------------------------------------------------------------

beao:IndependentWheelchairNavigation
    beao:removesBarrierTo icf:e120 ;   # personal mobility products (wheelchair)
    beao:removesBarrierTo icf:e150 ;   # architecture for public use
    beao:removesBarrierTo icf:e155 ;   # architecture for private use
    beao:removesBarrierTo icf:e515 ;   # architecture and construction services
    beao:removesBarrierTo icf:e520 ;   # open space planning services
    beao:relatedToActivity icf:d460 ;  # moving around in different locations
    beao:relatedToActivity icf:d465 ;  # moving around using equipment (wheelchair)
    beao:icfSystem <http://hl7.org/fhir/sid/icf> ;
    beao:normativeReference "NBR 9050:2020 §4.2.2, §6" .

