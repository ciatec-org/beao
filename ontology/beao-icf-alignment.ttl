    beao:relatedToActivity icf:d460 ;  # moving around in different locations
    beao:relatedToActivity icf:d465 ;  # moving around using equipment (wheelchair)
    beao:icfSystem <http://hl7.org/fhir/sid/icf> ;
    beao:normativeReference "NBR 9050:2020 §5.5, §6.3" .

# ------------------------------------------------------------------------------
# 11 — SafeIndependentUse
# Normative reference: NBR 9050:2020 §4, §6, §6.1.2, §7, §9
# Note: most transversal capability — spans all physical elements
# ------------------------------------------------------------------------------

beao:SafeIndependentUse
    beao:removesBarrierTo icf:e120 ;   # personal mobility products
    beao:removesBarrierTo icf:e150 ;   # architecture for public use
    beao:removesBarrierTo icf:e155 ;   # architecture for private use
    beao:removesBarrierTo icf:e240 ;   # light — illuminance and safety
    beao:removesBarrierTo icf:e515 ;   # architecture and construction services
    beao:removesBarrierTo icf:e520 ;   # open space planning services
    beao:removesBarrierTo icf:e525 ;   # housing services
    beao:relatedToActivity icf:d110 ;  # watching — perceiving obstacles and risks
    beao:relatedToActivity icf:d120 ;  # other purposeful sensing — tactile risk perception
    beao:relatedToActivity icf:d410 ;  # changing basic body position
    beao:relatedToActivity icf:d415 ;  # maintaining a body position
    beao:relatedToActivity icf:d420 ;  # transferring oneself
    beao:relatedToActivity icf:d445 ;  # hand and arm use (handrails)
    beao:relatedToActivity icf:d450 ;  # walking — safe displacement
    beao:relatedToActivity icf:d460 ;  # moving around in different locations
    beao:relatedToActivity icf:d465 ;  # moving around using equipment
    beao:relatedToActivity icf:d510 ;  # washing oneself — safe bathroom use
    beao:relatedToActivity icf:d520 ;  # caring for body parts
    beao:relatedToActivity icf:d530 ;  # toileting
    beao:relatedToActivity icf:d620 ;  # acquisition of goods and services
    beao:relatedToActivity icf:d910 ;  # community life
    beao:icfSystem <http://hl7.org/fhir/sid/icf> ;
    beao:normativeReference "NBR 9050:2020 §4, §6, §6.1.2, §7, §9" .

# ------------------------------------------------------------------------------
# 12 — ReducedMobilityNavigation
# Normative reference: NBR 9050:2020 §6.2.1, §6.6.2, §6.11.2.4, §6.11.2.5
#
# Modeling decision (CD-05):
#   P.M.R. is a distinct normative category in NBR 9050, but its physical
#   requirements always co-occur with IndependentWheelchairNavigation or
#   ReducedGraspStrength — never appears isolated in the data.
#   ICF alignment is declared as a subset of those two capabilities,
#   with explicit semantic distinction: d450/d460 (walking/moving on foot)
#   are the primary contexts — not d465 (using equipment/wheelchair),
#   which is specific to P.C.R.
#   P.M.R. represents a less severe functional restriction than P.C.R.,
#   but the physical requirements of the environment are identical or
#   more permissive.
#
# d455 EXCLUDED (v0.1.1): WHO ICF 2026-01 definition — "moving in ways
# other than walking" (crawling, climbing, swimming) — incompatible with
# P.M.R. using walker/crutch. d450 covers the correct context.
# ------------------------------------------------------------------------------

beao:ReducedMobilityNavigation
    beao:removesBarrierTo icf:e120 ;   # personal mobility products (walker, crutch)
    beao:removesBarrierTo icf:e150 ;   # architecture for public use
    beao:removesBarrierTo icf:e155 ;   # architecture for private use
    beao:removesBarrierTo icf:e515 ;   # architecture and construction services
    beao:removesBarrierTo icf:e520 ;   # open space planning services
    # Distinction from P.C.R.: d450/d460 primary; d465 absent (no wheelchair)
    beao:relatedToActivity icf:d450 ;  # walking — displacement on foot with reduced mobility
    beao:relatedToActivity icf:d460 ;  # moving around in different locations
    beao:relatedToActivity icf:d445 ;  # hand and arm use (crutch, walker)
    beao:relatedToActivity icf:d440 ;  # fine hand use — operation of elements
    beao:relatedToActivity icf:d620 ;  # acquisition of goods and services
    skos:broader beao:IndependentWheelchairNavigation ;
    skos:note "P.M.R. (Reduced Mobility Person) — normative category NBR 9050 §3.1. Physical requirements co-occur with IndependentWheelchairNavigation and ReducedGraspStrength. Semantic distinction: absence of d465 (propulsion equipment); d450 (walking) as primary context. d455 excluded in v0.1.1 — WHO ICF 2026-01 definition incompatible with P.M.R."@en ;
    beao:icfSystem <http://hl7.org/fhir/sid/icf> ;
    beao:normativeReference "NBR 9050:2020 §6.2.1, §6.6.2, §6.11.2.4, §6.11.2.5" .

# ==============================================================================
# SECTION 5 — THEORETICAL CONTRIBUTION (annotation)
#
# A ConformityAssessment with result earl:passed means the environment
# acts as a FACILITATOR in ICF terminology — e+ (positive qualifier).
# A ConformityAssessment with result earl:failed means the environment
# acts as a BARRIER — e. (negative qualifier, official WHO notation).
#
# Full inference chain:
#   PhysicalElement
#     ← (beao:appliesTo ← AccessibilityRequirement)
#     → (beao:addressesCapability →) FunctionalCapability
#     → (beao:removesBarrierTo →) icf:eXXX
#
#   ConformityAssessment [earl:passed]  → environment as facilitator (e+)
#   ConformityAssessment [earl:failed]  → environment as barrier (e.)
#
# This operationalization of ICF environmental factor qualification via
# measurable normative requirements has not been identified in previously
# published accessibility ontologies.
# ==============================================================================

# ==============================================================================
# SECTION 6 — PROVENANCE
# ==============================================================================

beao:ICFAlignmentProcess a prov:Activity ;
    rdfs:label "BEAO–ICF Alignment — ONTOLOGY_MAKER Integration Agent"@en ;
    prov:startedAtTime "2026-09-01"^^xsd:date ;
    prov:endedAtTime "2026-09-20"^^xsd:date .

<https://w3id.org/beao/icf-alignment>
    prov:wasGeneratedBy beao:ICFAlignmentProcess .

