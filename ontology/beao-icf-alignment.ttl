    beao:removesBarrierTo icf:e250 ;   # sound — auditory alarms
    beao:removesBarrierTo icf:e255 ;   # vibration — vibratory alarms
    beao:removesBarrierTo icf:e515 ;   # architecture and construction services
    beao:removesBarrierTo icf:e525 ;   # housing services
