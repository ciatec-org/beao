    beao:removesBarrierTo icf:e545 ;   # civil protection services
    beao:relatedToActivity icf:d110 ;  # watching — visual emergency signals
    beao:relatedToActivity icf:d115 ;  # listening — auditory alarms
    beao:relatedToActivity icf:d120 ;  # other purposeful sensing — vibratory alarms
    beao:relatedToActivity icf:d310 ;  # communicating — bidirectional rescue area
    beao:relatedToActivity icf:d415 ;  # maintaining a body position — awaiting rescue
